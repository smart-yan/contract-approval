# ==========================================================================
# 合同审批审查系统 - 环境变量模板
#
# 使用方法：复制本文件为 .env，然后填入本机真实值。
#   .env 已被 .gitignore 忽略，**永远不会提交到 Git**。
#   数据库密码只存在于你本机的 .env 中，不写入代码、日志或聊天。
# ==========================================================================

# ---------------------------- 应用 ----------------------------
APP_NAME=合同审批审查系统
APP_ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------------------------- MySQL ----------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# 由你在本机 .env 中自行填写，不要提交
MYSQL_PASSWORD=
MYSQL_DB=contract_approval

# 连接池（§17.2：P2 需交付 DB 连接池配置）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ---------------------------- 日志 ----------------------------
LOG_LEVEL=INFO
# json（结构化，生产/演示） | console（本地可读）
LOG_FORMAT=json

# ------------------- 并发模型基座（架构文档 §1.3）-------------------
# 同步阻塞 I/O 用的默认线程池大小（python-docx / PyMuPDF 等 C 扩展走这里）
THREAD_POOL_SIZE=16

# OCR 执行器模式：process（默认，独立进程池） | thread（实测更优时可切换）
OCR_EXECUTOR_MODE=process
# OCR 进程池大小。默认 1，避免 Worker 数 × 进程池大小 造成进程爆炸。
# 允许值 1 / 2 / 4
OCR_MAX_WORKERS=1
